{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack framework built with TypeScript and Go",
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "build": "pnpm -r build",
    "build:app": "pnpm build && pnpm exec aether build",
    "dev": "pnpm exec aether dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@aether/cli": "workspace:*",
    "typescript": "^7.0.2"
  }
}
